<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bandb.controller.InventoryController"
            style="-fx-background-color: #FFF8FB;">

    <left>
        <VBox prefWidth="220" spacing="16"
              style="-fx-background-color: #F8DCE8; -fx-padding: 25 15;">

            <Label text="Blush &amp; Bloom" wrapText="true"
                   style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #A65378;"/>

            <Label text="ADMIN AREA"
                   style="-fx-font-size: 10px; -fx-text-fill: #B77B96;"/>

            <Separator/>

            <Button text="Home" onAction="#handleHome" maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6; -fx-text-fill: #A65378; -fx-background-radius: 10; -fx-padding: 12;"/>

            <Button text="Shop Products" onAction="#handleShop" maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6; -fx-text-fill: #A65378; -fx-background-radius: 10; -fx-padding: 12;"/>

            <Button text="Manage Inventory" maxWidth="Infinity"
                    style="-fx-background-color: #D97DA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6; -fx-text-fill: #A65378; -fx-background-radius: 10; -fx-padding: 12;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background: #FFF8FB; -fx-background-color: transparent;">
            <content>
                <VBox spacing="16" style="-fx-padding: 28;">

                    <Label text="Manage Inventory"
                           style="-fx-font-size: 29px; -fx-font-weight: bold; -fx-text-fill: #A65378;"/>

                    <Label fx:id="summaryLabel"
                           style="-fx-font-size: 13px; -fx-text-fill: #997585;"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" prefWidth="340"
                                   promptText="Search name, category, shade, brand..."/>
                        <Label text="Sort by:" style="-fx-text-fill: #79576A;"/>
                        <ComboBox fx:id="sortCombo" prefWidth="190"/>
                    </HBox>

                    <TableView fx:id="productTable" prefHeight="300" minHeight="220"/>

                    <VBox spacing="12"
                          style="-fx-background-color: #FCE7F0; -fx-background-radius: 15; -fx-padding: 18;">

                        <Label fx:id="formTitle" text="Add a new product"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #A65378;"/>

                        <GridPane hgap="14" vgap="10">
                            <Label text="Category" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="categoryCombo" prefWidth="180"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Name" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <TextField fx:id="nameField" prefWidth="180"
                                       GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                            <Label text="Brand" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="brandField" prefWidth="180"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Shade" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <TextField fx:id="shadeField" prefWidth="180"
                                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                            <Label text="Color (hex)" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <TextField fx:id="colorField" prefWidth="180" promptText="#F4D9C9"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Skin tone" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                            <ComboBox fx:id="toneCombo" prefWidth="180"
                                      GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                            <Label text="Price (₱)" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="priceField" prefWidth="180"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Stock" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                            <TextField fx:id="stockField" prefWidth="180"
                                       GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                        </GridPane>

                        <HBox spacing="10">
                            <Button text="Add Product" onAction="#handleAdd"
                                    style="-fx-background-color: #D97DA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>
                            <Button text="Update Selected" onAction="#handleUpdate"
                                    style="-fx-background-color: #E9A6C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>
                            <Button text="Delete Selected" onAction="#handleDelete"
                                    style="-fx-background-color: #B94F7A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>
                            <Button text="Clear Form" onAction="#handleClear"
                                    style="-fx-background-color: #FBE1EC; -fx-text-fill: #A65378; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
