<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bandb.controller.ProductsController"
            style="-fx-background-color: #FFF8FB;">
    <left>
        <VBox prefWidth="220" spacing="16"
              style="-fx-background-color: #F8DCE8; -fx-padding: 25 15;">

            <Label text="Blush &amp; Bloom" wrapText="true"
                   style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #A65378;"/>

            <Label text="YOUR BEAUTY SPACE"
                   style="-fx-font-size: 10px; -fx-text-fill: #B77B96;"/>

            <Separator/>

            <Button text="Home" onAction="#handleHome"
                    maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6; -fx-text-fill: #A65378; -fx-background-radius: 10; -fx-padding: 12;"/>

            <Button text="Shop Products" maxWidth="Infinity"
                    style="-fx-background-color: #D97DA5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12;"/>

            <Button fx:id="cartCountButton" text="My Cart (0)"
                    onAction="#handleCart" maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6; -fx-text-fill: #A65378; -fx-background-radius: 10; -fx-padding: 12;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout" onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6; -fx-text-fill: #A65378; -fx-background-radius: 10; -fx-padding: 12;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background: #FFF8FB; -fx-background-color: transparent;">
            <content>
                <VBox spacing="20" style="-fx-padding: 30;">

                    <Label text="The Beauty Collection"
                           style="-fx-font-size: 29px; -fx-font-weight: bold; -fx-text-fill: #A65378;"/>

                    <Label text="Explore beautiful shades made for every bloom."
                           wrapText="true"
                           style="-fx-font-size: 14px; -fx-text-fill: #997585;"/>

                    <VBox spacing="8"
                          style="-fx-background-color: #FCE7F0; -fx-background-radius: 15; -fx-padding: 18;">
                        <Label text="Your Personalized Beauty Picks"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #A65378;"/>

                        <Label fx:id="skinToneLabel"
                               style="-fx-font-size: 14px; -fx-text-fill: #79576A;"/>

                        <Label text="Products marked RECOMMENDED FOR YOU match your selected skin tone. You can shop any shade you love!"
                               wrapText="true"
                               style="-fx-font-size: 12px; -fx-text-fill: #997585;"/>
                    </VBox>

                    <VBox spacing="13" style="-fx-padding: 10 0 28 0;">
                        <Label text="Find Your Beauty"
                               style="-fx-text-fill: #A65378; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="⌕"
                                   style="-fx-text-fill: #C45D89; -fx-font-size: 28px;"/>
                            <TextField fx:id="searchField"
                                       prefWidth="650" minWidth="350"
                                       maxWidth="750" prefHeight="48"
                                       promptText="Search makeup, category, or shade..."
                                       style="-fx-background-color: white; -fx-background-radius: 26; -fx-border-color: #E9A6C0; -fx-border-width: 1.5; -fx-border-radius: 26; -fx-padding: 12 20; -fx-font-size: 14px; -fx-text-fill: #674457; -fx-prompt-text-fill: #B79BA8;"/>
                        </HBox>
                    </VBox>

                    <Label text="Shop by Category"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #805166;"/>

                    <FlowPane hgap="10" vgap="10">
                        <Button fx:id="allButton"
                                text="All Products" onAction="#showAll"/>
                        <Button fx:id="foundationButton"
                                text="Foundation" onAction="#showFoundation"/>
                        <Button fx:id="blushButton"
                                text="Blush" onAction="#showBlush"/>
                        <Button fx:id="lipstickButton"
                                text="Lipstick" onAction="#showLipstick"/>
                    </FlowPane>

                    <Label fx:id="productCountLabel"
                           style="-fx-font-size: 13px; -fx-text-fill: #A77C8F;"/>

                    <FlowPane fx:id="productGrid"
                              hgap="18" vgap="18"
                              alignment="TOP_LEFT"
                              prefWrapLength="750"/>

                    <Label text="Find your perfect bloom. ♥"
                           style="-fx-font-size: 13px; -fx-text-fill: #C1849E;"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
