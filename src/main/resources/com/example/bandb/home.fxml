
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bandb.HomeController"
            style="-fx-background-color: #FFF8FB;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="220"
              spacing="16"
              style="-fx-background-color: #F8DCE8;
                     -fx-padding: 25 15;">

            <Label text="Blush &amp; Bloom"
                   wrapText="true"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #A65378;"/>

            <Label text="YOUR BEAUTY SPACE"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #B77B96;"/>

            <Separator/>

            <Button text="Home"
                    maxWidth="Infinity"
                    style="-fx-background-color: #D97DA5;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 12;"/>

            <Button text="Shop Products"
                    onAction="#handleProducts"
                    maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6;
                           -fx-text-fill: #A65378;
                           -fx-background-radius: 10;
                           -fx-padding: 12;"/>

            <Button text="My Cart"
                    onAction="#handleCart"
                    maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6;
                           -fx-text-fill: #A65378;
                           -fx-background-radius: 10;
                           -fx-padding: 12;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F6;
                           -fx-text-fill: #A65378;
                           -fx-background-radius: 10;
                           -fx-padding: 12;"/>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #FFF8FB;
                           -fx-background-color: transparent;">

            <content>
                <VBox spacing="24"
                      style="-fx-padding: 30;">

                    <Label text="Welcome to Blush &amp; Bloom!"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #A65378;"/>

                    <Label text="Discover your beauty, one bloom at a time."
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #997585;"/>

                    <!-- ROSE BANNER -->
                    <StackPane fx:id="bannerContainer"
                               prefHeight="260"
                               minHeight="260"
                               maxHeight="260"
                               style="-fx-background-color: #F9DFE9;
                                      -fx-background-radius: 20;">

                        <ImageView fx:id="bannerImage"
                                   preserveRatio="false"
                                   smooth="true"
                                   mouseTransparent="true">
                            <image>
                                <Image url="@beauty-banner.jpg"/>
                            </image>
                        </ImageView>

                        <HBox alignment="CENTER_LEFT"
                              style="-fx-padding: 30;">

                            <VBox spacing="12"
                                  maxWidth="450"
                                  style="-fx-background-color: rgba(255,240,247,0.88);
                                         -fx-background-radius: 18;
                                         -fx-padding: 25;">

                                <Label text="THE BEAUTY EDIT"
                                       style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #A65378;"/>

                                <Label text="Find Your Perfect Bloom"
                                       wrapText="true"
                                       style="-fx-font-size: 25px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #8F4265;"/>

                                <Label text="Beautiful shades, made to celebrate you."
                                       wrapText="true"
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #997585;"/>

                                <Button text="Shop the Collection"
                                        onAction="#handleProducts"
                                        style="-fx-background-color: #D97DA5;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 10;
                                               -fx-padding: 10 20;"/>

                            </VBox>

                        </HBox>

                    </StackPane>

                    <!-- SKIN TONE -->
                    <VBox spacing="10"
                          style="-fx-background-color: #FCE7F0;
                                 -fx-background-radius: 16;
                                 -fx-padding: 20;">

                        <Label text="Your Personalized Beauty Match"
                               style="-fx-font-size: 19px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #A65378;"/>

                        <HBox spacing="8"
                              alignment="CENTER_LEFT">

                            <Label text="Your skin tone:"
                                   style="-fx-text-fill: #79576A;"/>

                            <Label fx:id="skinToneLabel"
                                   style="-fx-font-weight: bold;
                                          -fx-text-fill: #A65378;"/>

                        </HBox>

                        <Label fx:id="beautyMessage"
                               wrapText="true"
                               style="-fx-text-fill: #997585;"/>

                    </VBox>

                    <!-- RECOMMENDED PRODUCTS -->
                    <Label text="Recommended for You"
                           style="-fx-font-size: 23px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #A65378;"/>

                    <FlowPane hgap="18"
                              vgap="18"
                              alignment="TOP_LEFT">

                        <!-- FOUNDATION -->
                        <VBox spacing="12"
                              alignment="TOP_CENTER"
                              prefWidth="215"
                              minWidth="215"
                              maxWidth="215"
                              prefHeight="510"
                              minHeight="510"
                              maxHeight="510"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-border-color: #F2DAE4;
                                     -fx-border-radius: 18;
                                     -fx-padding: 15;">

                            <StackPane fx:id="foundationContainer"
                                       prefWidth="185"
                                       prefHeight="220"
                                       minHeight="220"
                                       maxHeight="220"
                                       style="-fx-background-color: #FFF5F9;
                                              -fx-background-radius: 14;"/>

                            <Label text="FOUNDATION"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #B67B91;"/>

                            <Label text="Glow Foundation"
                                   wrapText="true"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #563C49;"/>

                            <Label fx:id="foundationShade"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #846A76;"/>

                            <Label text="₱399.00"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #C45D89;"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Shop Now"
                                    onAction="#handleProducts"
                                    prefWidth="185"
                                    style="-fx-background-color: #E9A6C0;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 10;
                                           -fx-padding: 10;"/>

                        </VBox>

                        <!-- BLUSH -->
                        <VBox spacing="12"
                              alignment="TOP_CENTER"
                              prefWidth="215"
                              minWidth="215"
                              maxWidth="215"
                              prefHeight="510"
                              minHeight="510"
                              maxHeight="510"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-border-color: #F2DAE4;
                                     -fx-border-radius: 18;
                                     -fx-padding: 15;">

                            <StackPane fx:id="blushContainer"
                                       prefWidth="185"
                                       prefHeight="220"
                                       minHeight="220"
                                       maxHeight="220"
                                       style="-fx-background-color: #FFF5F9;
                                              -fx-background-radius: 14;"/>

                            <Label text="BLUSH"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #B67B91;"/>

                            <Label text="Dreamy Blush"
                                   wrapText="true"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #563C49;"/>

                            <Label fx:id="blushShade"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #846A76;"/>

                            <Label text="₱249.00"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #C45D89;"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Shop Now"
                                    onAction="#handleProducts"
                                    prefWidth="185"
                                    style="-fx-background-color: #E9A6C0;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 10;
                                           -fx-padding: 10;"/>

                        </VBox>

                        <!-- LIPSTICK -->
                        <VBox spacing="12"
                              alignment="TOP_CENTER"
                              prefWidth="215"
                              minWidth="215"
                              maxWidth="215"
                              prefHeight="510"
                              minHeight="510"
                              maxHeight="510"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-border-color: #F2DAE4;
                                     -fx-border-radius: 18;
                                     -fx-padding: 15;">

                            <StackPane fx:id="lipstickContainer"
                                       prefWidth="185"
                                       prefHeight="220"
                                       minHeight="220"
                                       maxHeight="220"
                                       style="-fx-background-color: #FFF5F9;
                                              -fx-background-radius: 14;"/>

                            <Label text="LIPSTICK"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #B67B91;"/>

                            <Label text="Bloom Kiss Lipstick"
                                   wrapText="true"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #563C49;"/>

                            <Label fx:id="lipstickShade"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #846A76;"/>

                            <Label text="₱199.00"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #C45D89;"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Shop Now"
                                    onAction="#handleProducts"
                                    prefWidth="185"
                                    style="-fx-background-color: #E9A6C0;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 10;
                                           -fx-padding: 10;"/>

                        </VBox>

                    </FlowPane>

                    <Label text="Every shade is a beautiful way to bloom. ♥"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #C1849E;"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
