
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER" spacing="15"
      prefWidth="490" prefHeight="525"
      maxWidth="490" maxHeight="525"
      style="-fx-padding: 23; -fx-background-color: #FFF8FB; -fx-background-radius: 20;">
    <children>
        <Label text="♡  My Order History"
               style="-fx-text-fill: #994D72; -fx-font-size: 25px; -fx-font-weight: bold;"/>
        <Label text="Your previous Blush &amp; Bloom purchases"
               style="-fx-text-fill: #A78495; -fx-font-size: 12px;"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    prefViewportHeight="375" VBox.vgrow="ALWAYS"
                    style="-fx-background: #FFF8FB; -fx-background-color: transparent;">
            <content>
                <VBox fx:id="historyItems" spacing="13"
                      style="-fx-padding: 10;"/>
            </content>
        </ScrollPane>
        <Button fx:id="historyBackButton" text="Back to My Cart"
                maxWidth="Infinity"
                style="-fx-background-color: #D97DA5; -fx-text-fill: white; -fx-background-radius: 11; -fx-font-weight: bold; -fx-padding: 12 20;"/>
    </children>
</VBox>
